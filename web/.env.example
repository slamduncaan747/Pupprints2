# Pup Prints environment variables (names only; set real values in Vercel → Settings → Environment Variables).
# Every integration is optional: the site builds and renders without any of them.

# --- Site ---
NEXT_PUBLIC_SITE_URL=            # public origin for emails, Stripe redirects, reveal links (default https://pup-prints.vercel.app)
NEXT_PUBLIC_SUPPORT_EMAIL=       # support address shown in emails/pages (default hello@pupprints.shop)
NEXT_PUBLIC_PARTNERS_EMAIL=      # creator-program contact address (default: the support address)

# --- Social profiles (each link renders in the footer/JSON-LD only when set) ---
NEXT_PUBLIC_INSTAGRAM_URL=       # e.g. https://www.instagram.com/<our handle>
NEXT_PUBLIC_TIKTOK_URL=          # e.g. https://www.tiktok.com/@<our handle>
NEXT_PUBLIC_PINTEREST_URL=       # e.g. https://www.pinterest.com/<our handle>
NEXT_PUBLIC_FACEBOOK_URL=        # e.g. https://www.facebook.com/<our page>

# --- Ad pixels / analytics (each one loads only when set) ---
NEXT_PUBLIC_META_PIXEL_ID=       # Meta (Facebook/Instagram) Pixel id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=     # TikTok Pixel id
NEXT_PUBLIC_GA_ID=               # Google Analytics 4 measurement id (G-XXXXXXX)

# --- Supabase (server only) ---
NEXT_PUBLIC_SUPABASE_URL=        # project URL
SUPABASE_PUBLISHABLE_KEY=        # publishable (anon) key, used server-side only
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy fallback for SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVER_KEY=             # x-pp-server-key secret (matches private.app_secrets); also HMAC key for unsubscribe links

# --- Stripe ---
STRIPE_SECRET_KEY=               # missing → /api/checkout answers 503; also creates WELCOME10, FOUNDING100 and creator promo codes
STRIPE_WEBHOOK_SECRET=           # signing secret of the endpoint <site>/api/webhooks/stripe
                                 # events: checkout.session.completed, checkout.session.async_payment_succeeded,
                                 #         checkout.session.async_payment_failed, charge.refunded
STRIPE_AUTOMATIC_TAX=            # "1" to enable Stripe Tax on Checkout (requires Stripe Tax set up)

# --- Email (Resend) ---
RESEND_API_KEY=                  # missing → all emails are logged and skipped
EMAIL_FROM=                      # e.g. "Pup Prints <hello@pupprints.shop>" (domain verified in Resend)
EMAIL_REPLY_TO=                  # optional; defaults to NEXT_PUBLIC_SUPPORT_EMAIL
BUSINESS_POSTAL_ADDRESS=         # physical mailing address for marketing-email footers (CAN-SPAM); unset → welcome/nurture/review emails are skipped
REVIEW_URL=                      # where review-request emails point (e.g. Google review link); default mailto support

# --- AI image generation (providers tried in AI_PROVIDER_ORDER; one without its key is skipped) ---
# Verify a key in one command (from web/): npx tsx scripts/ai-smoke.ts <dog-photo.jpg> royal [--provider=openai|gemini]
AI_PROVIDER_ORDER=               # default "openai,gemini,fal,replicate" (also accepts fal-gpt)
OPENAI_API_KEY=                  # PRIMARY. platform.openai.com → API keys (needs prepaid credit; GPT Image may require Organization Verification)
OPENAI_IMAGE_MODEL=              # default gpt-image-2.5-flare (gpt-image-2.5-sunburst = more precise edits, ~1.5-2x slower)
OPENAI_IMAGE_QUALITY=            # low | medium | high (default high on GPT Image 2.5: ~$0.08, ~20-30 s; medium ~$0.03, ~15 s); xhigh | max also on 2.5
OPENAI_IMAGE_SIZE=               # default 1536x2048 (3:4) on GPT Image 2.x, 1024x1536 on gpt-image-1.x
GEMINI_API_KEY=                  # FALLBACK. aistudio.google.com → Get API key; the project needs billing (prepaid credit), image models have no free tier
GOOGLE_API_KEY=                  # alias for GEMINI_API_KEY
GEMINI_IMAGE_MODEL=              # default gemini-nano-banana-2.1 (Nano Banana 2.1)
GEMINI_API=                      # "interactions" (default, what Google's docs use) | "generate-content" (legacy API, still supported)
GEMINI_THINKING_LEVEL=           # minimal | medium | high (unset = model default, medium on Nano Banana 2.1)
AI_IMAGE_RESOLUTION=             # Gemini/fal/Replicate output size: 1K | 2K (default) | 4K
FAL_KEY=                         # optional: AI upscaling for print files (Topaz/SeedVR; without it a built-in upscaler is used) + fal fallback providers
FAL_IMAGE_MODEL=                 # override the fal model id (default google/nano-banana-2.1/edit)
FAL_FALLBACK_MODEL=              # override the fal-gpt model id (default openai/gpt-image-2.5/flare/edit)
FAL_GPT_QUALITY=                 # fal-gpt quality: low | medium (default) | high
REPLICATE_API_TOKEN=             # optional fallback provider
REPLICATE_IMAGE_MODEL=           # override the Replicate model id (default google/nano-banana-2.1)
AI_MOCK=                         # "1" = fake portraits for local dev (ignored in production)
AI_MOCK_DELAY_MS=                # simulated mock latency in ms (default 4000)

# --- Abuse / cost control ---
DAILY_GENERATION_LIMIT_PER_IP=   # AI previews per IP per day (default 12)
GLOBAL_DAILY_GENERATION_LIMIT=   # site-wide AI generations per rolling 24h; 0/unset = off
IP_HASH_SALT=                    # salt for hashed IPs (default: derived from SUPABASE_SERVER_KEY)

# --- Fulfillment ---
FULFILLMENT_PROVIDER=            # "printful" or "manual" (default manual: a person orders from the admin print-file links)
PRINTFUL_API_KEY=                # private token with orders + webhooks scopes
PRINTFUL_STORE_ID=               # only for account-level tokens
PRINTFUL_CONFIRM=                # "1" = submit orders for production immediately; otherwise they are created as drafts
PRINTFUL_WEBHOOK_SECRET=         # random string; register <site>/api/webhooks/printful/<secret> in Printful
PRINTFUL_PACKING_SLIP_LOGO_URL=  # optional black/white logo for the packing slip sticker
FULFILLMENT_AUTO_SUBMIT=         # "1" = send paid orders to the printer automatically (default: wait for admin approval)
GELATO_API_KEY=                  # reserved for a Gelato integration (not wired yet)
PRODIGI_API_KEY=                 # reserved for a Prodigi integration (not wired yet)
PRODIGI_SANDBOX=                 # "1" = Prodigi sandbox (reserved)

# --- Print files ---
PRINT_UPSCALER=                  # "topaz" (default) | "seedvr" (budget) | "none" (sharp lanczos3 only); needs FAL_KEY
CANVAS_WRAP_IN=                  # mirrored gallery-wrap band per side in inches (default 1.25; "0" = front-only canvas files)

# --- Cron ---
CRON_SECRET=                     # Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/lifecycle

# --- Admin ---
ADMIN_PASSWORD=                  # password for /admin
ADMIN_SESSION_SECRET=            # pepper for admin session tokens (default: SUPABASE_SERVER_KEY)

# NODE_ENV is set by Next.js/Vercel; don't set it yourself.
